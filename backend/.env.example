# ==============================================================================
# إعدادات خادم Mit AI Technology (Django Backend) - ملف توضيحي
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئة التشغيل
# ==============================================================================

# في الإنتاج: DEBUG=False و SECRET_KEY فريد وطويل (مطلوب، وإلا لن يعمل الخادم)
# توليد مفتاح:  python -c "import secrets; print(secrets.token_urlsafe(50))"
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,mitaitechnology.tech,www.mitaitechnology.tech

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_ALL_ORIGINS=True

# ------------------------------------------------------------------------------
# مزود الذكاء الاصطناعي للمساعد Mit
#   knowledge_base  قاعدة المعرفة المحلية (بدون مفتاح، الافتراضي)
#   anthropic       Claude API   (يتطلب AI_API_KEY)
#   openai          OpenAI API   (يتطلب AI_API_KEY)
#   groq            Groq         (يتطلب AI_API_KEY)
#   gemini          Google Gemini (يتطلب AI_API_KEY)
#   ollama          نموذج محلي عبر Ollama (AI_API_BASE اختياري)
#   custom          أي خادم متوافق مع OpenAI مثل vLLM (AI_API_BASE مطلوب)
# عند فشل المزود الخارجي يتراجع المساعد تلقائياً إلى knowledge_base.
# ------------------------------------------------------------------------------
AI_PROVIDER=knowledge_base
AI_API_KEY=
# اتركه فارغاً لاستخدام النموذج الافتراضي لكل مزود (anthropic: claude-opus-5-5، openai: gpt-4o-mini ...)
# لتقليل تكلفة Claude يمكنك استخدام: claude-sonnet-5-5
AI_MODEL_NAME=
AI_API_BASE=
